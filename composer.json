{
  "name": "tualo/connect-ai",
  "description": "Generic multi-connector library for AI providers and data sources",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas Hoffmann",
      "email": "thomas.hoffmann@tualo.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tualo\\Connect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tualo\\Connect\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "version": "1.0.1"
}
